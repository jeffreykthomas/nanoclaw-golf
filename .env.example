# Internal Rails coach/app bridge
ENABLE_COACH_AGENT=false
APP_PORT=3100
COACH_APP_URL=http://127.0.0.1:3000
CLAW_SIBLING_TOKEN=
COACH_FIRST_RESULT_TIMEOUT=180000

# Learning/report sync loops
AUTO_SELF_UNDERSTANDING_REPORTS_ENABLED=false
SELF_UNDERSTANDING_REPORTS_LOOP_INTERVAL_MS=3600000
SELF_UNDERSTANDING_REPORTS_BATCH_LIMIT=5
SELF_UNDERSTANDING_REPORTS_ALLOWED_HOURS=2

# Arccos sync
AUTO_ARCCOS_SYNC_ENABLED=false
ARCCOS_SYNC_LOOP_INTERVAL_MS=3600000
ARCCOS_SYNC_BATCH_LIMIT=3
ARCCOS_SYNC_ALLOWED_HOURS=3
ARCCOS_SYNC_ALLOWED_WEEKDAYS=1
ARCCOS_SYNC_CUTOFF_MONTHS=6
ARCCOS_SYNC_MAX_ROUNDS=150
ARCCOS_SYNC_TIMEOUT_MS=900000
ARCCOS_EMAIL=
ARCCOS_PASSWORD=

# Personal coach Google Drive access
# Base64-encoded service account JSON. Share the target folder with the service
# account email for personal Drive accounts, or use Workspace impersonation.
COACH_GOOGLE_SERVICE_ACCOUNT_JSON=
COACH_GOOGLE_IMPERSONATE_EMAIL=
COACH_GOOGLE_DRIVE_WRITE_FOLDER_ID=

# Bipbot ingress/gateway
BIPBOT_GATEWAY_URL=
BIPBOT_GATEWAY_TOKEN=
BIPBOT_FIREBASE_SERVICE_ACCOUNT_PATH=
BIPBOT_INGRESS_POLL_INTERVAL=10000
BIPBOT_INGRESS_AGENT_FOLDER=bipbot
BIPBOT_INGRESS_AGENT_NAME=BipBot

# BipBot Google Drive access
# Forwarded into the BipBot container as GOOGLE_SERVICE_ACCOUNT_JSON,
# GOOGLE_IMPERSONATE_EMAIL, and GOOGLE_DRIVE_WRITE_FOLDER_ID.
BIPBOT_GOOGLE_SERVICE_ACCOUNT_JSON=
BIPBOT_GOOGLE_IMPERSONATE_EMAIL=
BIPBOT_GOOGLE_DRIVE_WRITE_FOLDER_ID=

# Optional Telegram mirror and auto check-ins
TELEGRAM_BOT_TOKEN=
TELEGRAM_MIRROR_CHAT_ID=
AUTO_CHECKINS_ENABLED=false
CHECKIN_LOOP_INTERVAL_MS=3600000
CHECKIN_MIN_HOURS_SINCE_CHAT=20
CHECKIN_MIN_HOURS_SINCE_LAST_CHECKIN=24
CHECKIN_ALLOWED_HOURS=9
